{"old_home": "<!--holplug--><section class=\"mmh-holplug\" style=\"margin:0 auto 34px;max-width:980px;background:#fbf1e3;border:3px solid #a3192e;border-radius:22px;padding:26px 22px;text-align:center\"><p style=\"margin:0 0 4px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;font-size:13px;color:#1f5a3c\">New for the holidays</p><h2 style=\"margin:0 0 8px;color:#a3192e\">404 Holiday Mahjong Matches</h2><p style=\"margin:0 0 16px;color:#1f3a6b\">Christmas, Hanukkah and winter mats matched to 49 tile sets, with rack picks, from Dear Santa and Rackin\u2019 Rudolph to Nutcracker Ballet and Holly Jolly.</p><a class=\"mmh-btn\" href=\"/holiday-mahjong-matches\" style=\"display:inline-block;background:#a3192e;color:#fff!important;padding:12px 22px;border-radius:999px;font-weight:700;text-decoration:none\">See the holiday matches</a></section><!--/holplug-->", "new_home": "<!--holplug--><section class=\"mhx\" aria-label=\"Holiday mahjong matches\"><style>\n@import url('https://fonts.googleapis.com/css2?family=Caprasimo&display=swap');\n.mhx{--holly:#a3192e;--pine:#1f5a3c;--gold:#c99a3b;--cream:#fbf1e3;position:relative;max-width:1000px;margin:0 auto 38px;border-radius:26px;padding:10px;background:repeating-linear-gradient(-45deg,#a3192e 0 14px,#fff 14px 28px);box-shadow:0 18px 40px rgba(31,58,60,.18)}\n.mhx-in{position:relative;overflow:hidden;border-radius:18px;background:radial-gradient(circle at 12% 18%,rgba(201,154,59,.18) 0 2px,transparent 3px) 0 0/46px 46px,radial-gradient(circle at 70% 60%,rgba(163,25,46,.10) 0 2px,transparent 3px) 0 0/58px 58px,var(--cream);display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:24px;padding:34px 30px 34px 40px;text-decoration:none!important;color:inherit}\n.mhx-txt{position:relative;z-index:2}\n.mhx-eye{display:inline-block;margin:0 0 12px;background:var(--pine);color:#fff;font:700 12px/1 Bitter,Georgia,serif;letter-spacing:.22em;text-transform:uppercase;padding:9px 16px;border-radius:999px}\n.mhx-h{margin:0 0 10px!important;font-family:Caprasimo,Georgia,serif!important;font-weight:400!important;font-size:clamp(32px,4vw,46px)!important;line-height:1.02!important;color:var(--holly)!important;letter-spacing:0!important}\n.mhx-h span{color:var(--pine)}\n.mhx-count{margin:0 0 8px;font:700 19px/1.3 Bitter,Georgia,serif;color:var(--pine)}\n.mhx-count b{color:var(--holly)}\n.mhx-p{margin:0 0 20px;font:400 16px/1.5 Bitter,Georgia,serif;color:#1f3a6b}\n.mhx-btn{display:inline-block;background:var(--holly);color:#fff!important;font:700 16px/1 Bitter,Georgia,serif;padding:15px 26px;border-radius:999px;box-shadow:0 6px 0 #6e0f1f;transition:transform .15s}\n.mhx-in:hover .mhx-btn{transform:translateY(-2px)}\n.mhx-fan{position:relative;height:330px}\n.mhx-c{position:absolute;top:50%;left:46%;width:136px;aspect-ratio:4/5;object-fit:cover;border-radius:12px;border:5px solid #fff;box-shadow:0 10px 22px rgba(31,58,60,.28);transform-origin:50% 120%}\n.mhx-c0{transform:translate(-50%,-50%) translate(-126px,6px) rotate(-16deg);z-index:1}.mhx-c1{transform:translate(-50%,-50%) translate(-84px,-8px) rotate(-10deg);z-index:2}.mhx-c2{transform:translate(-50%,-50%) translate(-42px,-18px) rotate(-4deg);z-index:3}.mhx-c3{transform:translate(-50%,-50%) translate(0px,-22px) rotate(2deg);z-index:7}.mhx-c4{transform:translate(-50%,-50%) translate(42px,-18px) rotate(8deg);z-index:4}.mhx-c5{transform:translate(-50%,-50%) translate(84px,-8px) rotate(13deg);z-index:3}.mhx-c6{transform:translate(-50%,-50%) translate(126px,6px) rotate(18deg);z-index:2}.mhx-c3{width:156px}\n.mhx-bow{position:absolute;top:-6px;left:50%;transform:translateX(-50%);width:84px;height:46px;z-index:9}\n@media(max-width:760px){.mhx{margin:0 12px 30px;padding:8px}.mhx-in{grid-template-columns:1fr;padding:22px 18px 26px;text-align:center}.mhx-fan{order:-1;height:230px}.mhx-c{width:100px}.mhx-c0{transform:translate(-50%,-50%) translate(-80px,4px) rotate(-16deg)}.mhx-c1{transform:translate(-50%,-50%) translate(-54px,-6px) rotate(-10deg)}.mhx-c2{transform:translate(-50%,-50%) translate(-27px,-14px) rotate(-4deg)}.mhx-c3{transform:translate(-50%,-50%) translate(0px,-18px) rotate(2deg)}.mhx-c4{transform:translate(-50%,-50%) translate(27px,-14px) rotate(8deg)}.mhx-c5{transform:translate(-50%,-50%) translate(54px,-6px) rotate(13deg)}.mhx-c6{transform:translate(-50%,-50%) translate(80px,4px) rotate(18deg)}.mhx-c3{width:116px}.mhx-p{font-size:15px}}\n</style><a class=\"mhx-in\" href=\"/holiday-mahjong-matches\"><div class=\"mhx-txt\"><p class=\"mhx-eye\">New for the holidays</p><h2 class=\"mhx-h\">Holiday Mahjong <span>Matches</span></h2><p class=\"mhx-count\"><b>400+</b> holiday matches and counting</p><p class=\"mhx-p\">Christmas, Hanukkah and winter mats matched to your tiles, with rack picks, from Dear Santa and Rackin&rsquo; Rudolph to Nutcracker Ballet and Holly Jolly.</p><span class=\"mhx-btn\">See the holiday matches</span></div><div class=\"mhx-fan\"><img class=\"mhx-c mhx-c0\" src=\"https://cdn.jsdelivr.net/gh/tiffanybrie/mahjmatchmaker-data@d295125ab4c1640c0b8099150d30acde2c3adcd9/assets/covers/holiday/w800/rackin-rudolph.jpg\" alt=\"Rackin' Rudolph holiday mahjong tile matches\" loading=\"lazy\"><img class=\"mhx-c mhx-c1\" src=\"https://cdn.jsdelivr.net/gh/tiffanybrie/mahjmatchmaker-data@d295125ab4c1640c0b8099150d30acde2c3adcd9/assets/covers/holiday/w800/holly-jolly-red.jpg\" alt=\"Holly Jolly Rudolph Red holiday mahjong tile matches\" loading=\"lazy\"><img class=\"mhx-c mhx-c2\" src=\"https://cdn.jsdelivr.net/gh/tiffanybrie/mahjmatchmaker-data@d295125ab4c1640c0b8099150d30acde2c3adcd9/assets/covers/holiday/w800/nutcracker-ballet.jpg\" alt=\"Nutcracker Ballet holiday mahjong tile matches\" loading=\"lazy\"><img class=\"mhx-c mhx-c3\" src=\"https://cdn.jsdelivr.net/gh/tiffanybrie/mahjmatchmaker-data@d295125ab4c1640c0b8099150d30acde2c3adcd9/assets/covers/holiday/w800/dear-santa.jpg\" alt=\"Anders Ruff Dear Santa holiday mahjong tile matches\" loading=\"lazy\"><img class=\"mhx-c mhx-c4\" src=\"ht